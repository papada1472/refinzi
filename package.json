{
  "name": "refinzi",
  "productName": "Refinzi",
  "version": "2.1.0",
  "description": "Refinzi — the browser-native AI prompt layer. Click the Orb for a Better prompt, hold for an Expert one. Works in ChatGPT, Claude, Gemini, and Perplexity.",
  "type": "module",
  "author": "",
  "license": "MIT",
  "homepage": "https://refinzi.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/papada1472/refinzi.git"
  },
  "bugs": {
    "url": "https://github.com/papada1472/refinzi/issues"
  },
  "private": true,
  "scripts": {
    "build": "node scripts/build-extension.js all",
    "build:chrome": "node scripts/build-extension.js chrome",
    "build:edge": "node scripts/build-extension.js edge",
    "build:firefox": "node scripts/build-extension.js firefox",
    "build:extension": "node scripts/build-extension.js all",
    "lint": "node scripts/lint-extension.js",
    "typecheck": "tsc --noEmit -p extension/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:release": "npm test && npm run build",
    "perf": "tsx scripts/perf-benchmark.ts",
    "harness:deepseek": "tsx scripts/deepseek-harness.js"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
